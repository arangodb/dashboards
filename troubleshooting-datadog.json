              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:arangodb.arangodb_process_statistics_system_time{$pod} by {shortname}"
              },
              {
                "data_source": "metrics",
                "name": "query2",
                "query": "avg:arangodb.arangodb_process_statistics_user_time{$pod} by {shortname}"
